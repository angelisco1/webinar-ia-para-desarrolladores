{
  "name": "resttek",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @resttek/api",
    "dev:admin": "npm run start -w @resttek/web-admin",
    "dev:empleados": "npm run start -w @resttek/web-empleados",
    "dev:clientes": "npm run start -w @resttek/web-clientes",
    "test": "npm run test -w @resttek/api",
    "seed": "npm run seed -w @resttek/api",
    "test:admin": "npm test -w @resttek/web-admin",
    "test:e2e": "playwright test",
    "e2e:video": "playwright test e2e/dish-form-keyboard-video.spec.ts --headed"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1"
  }
}
